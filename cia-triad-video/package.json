{
  "name": "cia-triad-documentary",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npx remotion studio src/index.ts --host 0.0.0.0 --port 3002",
    "still": "npx remotion still src/index.ts CiaTriad",
    "build:video": "npx remotion render src/index.ts CiaTriad out/cia-triad.mp4 --codec h264 --crf 18 --pixel-format yuv420p --concurrency=2",
    "audio": "python3 ../.venv/bin/python scripts/build_audio.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.360"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.360",
    "@types/react": "^18.3.0",
    "typescript": "^5.7.0"
  }
}
